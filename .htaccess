# Monkey Scout — clean URLs for Apache
# Put this file in the website's public/document root, beside dashboard.html.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect /index.html to the homepage.
  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]) [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # Redirect /page.html to /page (preserves query strings).
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[\s?]) [NC]
  RewriteRule ^(.+?)\.html$ /$1 [R=301,L,NE]

  # Internally serve /page from /page.html when that file exists.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [END]
</IfModule>

DirectoryIndex index.html
